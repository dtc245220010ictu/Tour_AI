# Application Configuration
# Use a long random value in every real deployment; do not reuse this placeholder.
SECRET_KEY=replace_with_a_long_random_secret
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Demo quick-login on the /login page (set to 0 to hide/disable in production)
ENABLE_DEMO_QUICK_LOGIN=1

# Auto-seed demo data (tours, schedules, bookings...) on app startup.
# Default 0: the system only keeps real data created by users.
# Set to 1 to load demo/sample data automatically on a fresh database.
SEED_DEMO_DATA=0

# MySQL 8 Database Configuration
# Create MYSQL_DB before starting the application. Do not commit a real password.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tourai_app
MYSQL_PASSWORD=replace_with_a_strong_database_password
MYSQL_DB=tourai
# Dedicated database used only by pytest. It is dropped and recreated on each run.
MYSQL_TEST_DB=tourai_test

# Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Set the real key in your local .env file (which is gitignored). Never commit real keys.
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Timeout gọi Gemini (giây). Sinh mô tả tour + lịch trình cần ~15-25 giây,
# đừng đặt quá thấp nếu không muốn hệ thống rơi về nội dung mẫu.
GEMINI_TIMEOUT=60

