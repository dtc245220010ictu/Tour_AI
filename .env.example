# Application Configuration
SECRET_KEY=tour_ai_super_secret_key_2026
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Demo quick-login on the /login page (set to 0 to hide/disable in production)
ENABLE_DEMO_QUICK_LOGIN=1

# Auto-seed demo data (tours, schedules, bookings...) on app startup.
# Default 0: the system only keeps real data created by users.
# Set to 1 to load demo/sample data automatically on a fresh database.
SEED_DEMO_DATA=0

# Database Configuration (Defaults to SQLite in database/tour_ai.db)
# To use MySQL in production, set DATABASE_URL or the variables below:
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/tour_ai_db
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DB=tour_ai_db

# Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Set the real key in your local .env file (which is gitignored). Never commit real keys.
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

